# Root-level ignores. backend/ and frontend/ have their own .gitignore files;
# these patterns are a safety net so a new service added anywhere in the tree
# is protected without needing to remember to add another .gitignore.

# Secrets -- never commit these
.env
.env.local
.env.*.local
.env.development
.env.production
serviceAccountKey.json
*-service-account-key.json
*.pem
*.key

# Dependencies
node_modules/

# Build output
dist/
build/
dist-ssr/

# User uploads (may contain personal data)
uploads/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime
*.pid
*.seed
*.pid.lock

# Internal working docs - not for the public repo
PROJECT_AUDIT.md
RENAME_IMPACT_REPORT.md
PHASE1_RENAME_COMPLETE.md
