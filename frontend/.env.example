# Frontend Environment Configuration

# Firebase API Configuration
# Get API key from Firebase Console > Project Settings > General
VITE_FIREBASE_APIKEY="your-firebase-api-key-here"

# Razorpay Key ID (public key, safe to expose)
# Must match backend RAZORPAY_KEY_ID
# Get from Razorpay Dashboard > Account & Billing > API Keys
VITE_RAZORPAY_KEY_ID="your-razorpay-key-id-here"

# Backend Gateway URL
VITE_BACKEND_URL="http://localhost:8000"
