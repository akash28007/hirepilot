# Billing Service Configuration
PORT=8005

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017/hirepilot-billing"

# Razorpay Configuration
# Get keys from Razorpay Dashboard > Account & Billing > API Keys
# Key ID is public, Key Secret must be kept confidential
RAZORPAY_KEY_ID="your-razorpay-key-id-here"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret-here"

# Auth service URL (the coin ledger: charge, refund and credit go through it)
AUTH_SERVICE_URL="http://localhost:8001"

# Shared secret for service-to-service calls. Use the SAME value in the
# gateway and every service. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY="change-me-to-a-long-random-string"
