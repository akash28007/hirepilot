# Billing Service Configuration
PORT=8005

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017/hirepilot-billing"

# Razorpay Configuration
# Get keys from Razorpay Dashboard > Account & Billing > API Keys
# Key ID is public, Key Secret must be kept confidential
RAZORPAY_KEY_ID="your-razorpay-key-id-here"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret-here"
