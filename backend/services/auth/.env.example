# Auth Service Configuration
PORT=8001

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017/hirepilot-users"

# Redis Configuration
REDIS_URL="redis://localhost:6380"

# Firebase Admin SDK - Service Account
# OPTION 1 (Recommended for production): Set as environment variable with JSON string
# Convert the JSON from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# to a single-line JSON string and set here
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# OPTION 2 (For development): Keep the serviceAccountKey.json file
# WARNING: NEVER commit serviceAccountKey.json to version control
# The application will warn if loading from file instead of environment variable
FIREBASE_SERVICE_ACCOUNT_KEY=""
