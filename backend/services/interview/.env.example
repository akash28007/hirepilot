# Interview Service Configuration
PORT=8003

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017/hirepilot-interview"

# Redis Configuration
REDIS_URL="redis://localhost:6380"

# Groq API Configuration
# Get API key from https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# Auth service URL (the coin ledger: charge, refund and credit go through it)
AUTH_SERVICE_URL="http://localhost:8001"

# Shared secret for service-to-service calls. Use the SAME value in the
# gateway and every service. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY="change-me-to-a-long-random-string"
